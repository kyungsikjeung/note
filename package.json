{
  "name": "ksnote",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first smart workspace for notes, code, tables, images, and diagrams.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n renderer,electron \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron": "wait-on http://127.0.0.1:5173 && nodemon --watch electron --ext cjs --signal SIGTERM --exec \"electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "mcp:ksnote": "node mcp/ksnote-server.mjs",
    "test:mvp-target": "node --test tests/target-ref.test.mjs",
    "test:mvp-diagrams": "node --test tests/diagram-validation.test.mjs",
    "test:mvp": "node --test tests/target-ref.test.mjs tests/diagram-validation.test.mjs tests/markdown-table-paste.test.mjs tests/editor-content.test.mjs tests/editor-source-regressions.test.mjs tests/mermaid-render-cache.test.mjs tests/last-location.test.mjs tests/font-size-selection.test.mjs tests/drawio-preview.test.mjs tests/write-approval.test.mjs tests/note-html.test.mjs tests/package-config.test.mjs tests/atomic-write.test.mjs",
    "verify:mcp-diagrams": "node scripts/verify-diagram-e2e.mjs",
    "package:win": "npm run build && electron-builder --win --dir"
  },
  "build": {
    "appId": "dev.ksnote.orbit42",
    "productName": "KsNote",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "mcp/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-resources/plantuml/plantuml.jar",
        "to": "plantuml/plantuml.jar"
      }
    ],
    "win": {
      "target": [
        "dir"
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tiptap/extension-code-block-lowlight": "^3.27.4",
    "@tiptap/extension-color": "^3.27.4",
    "@tiptap/extension-drag-handle-react": "^3.27.4",
    "@tiptap/extension-highlight": "^3.27.4",
    "@tiptap/extension-image": "^3.27.4",
    "@tiptap/extension-link": "^3.27.4",
    "@tiptap/extension-table": "^3.27.4",
    "@tiptap/extension-table-cell": "^3.27.4",
    "@tiptap/extension-table-header": "^3.27.4",
    "@tiptap/extension-table-row": "^3.27.4",
    "@tiptap/extension-task-item": "^3.27.4",
    "@tiptap/extension-task-list": "^3.27.4",
    "@tiptap/extension-text-align": "^3.27.4",
    "@tiptap/extension-text-style": "^3.27.4",
    "@tiptap/extension-underline": "^3.27.4",
    "@tiptap/pm": "^3.27.4",
    "@tiptap/react": "^3.27.4",
    "@tiptap/starter-kit": "^3.27.4",
    "@vitejs/plugin-react": "latest",
    "docx": "^9.7.1",
    "dompurify": "^3.4.12",
    "highlight.js": "latest",
    "lowlight": "^3.3.0",
    "lucide-react": "latest",
    "marked": "latest",
    "mermaid": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sql.js": "^1.14.1",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14",
    "wait-on": "latest"
  }
}
